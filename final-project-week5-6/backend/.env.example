PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DEMO_PAYMENT_MODE=true

# Database
MONGO_URI=mongodb://127.0.0.1:27017/projecthub

# JWT
JWT_SECRET=replace_with_long_random_secret

# Razorpay (real mode only; leave unset or unused when DEMO_PAYMENT_MODE=true)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: image upload folder
UPLOADS_DIR=uploads

# Demo payment mode is for local development/demo use only.
# It simulates premium payment and does not create a real financial transaction.
# Set DEMO_PAYMENT_MODE=false when re-enabling the real Razorpay integration.
